---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import { getCollection } from 'astro:content';

const allWriteups = await getCollection('writeups');
const writeups = allWriteups
  .filter((w) => !w.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const categories = ['all', ...new Set(allWriteups.map((w) => w.data.category))];

function categoryColor(category: string) {
  switch (category.toLowerCase()) {
    case 'web': return 'text-accent border-accent/30';
    case 'pwn': return 'text-danger border-danger/30';
    case 'crypto': return 'text-info border-info/30';
    case 'forensics': return 'text-warning border-warning/30';
    case 'cve': return 'text-danger border-danger/30';
    case 'htb': return 'text-accent border-accent/30';
    case 'reverse': return 'text-info border-info/30';
    default: return 'text-text-muted border-border';
  }
}
---

<Layout title="Writeups | Jonas Resch">
  <Nav />
  <main class="pt-14">
    <section class="py-24">
      <div class="max-w-6xl mx-auto px-6">
        <!-- Header -->
        <div class="mb-16">
          <a href="/" class="font-mono text-sm text-text-muted hover:text-accent transition-colors mb-6 inline-flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="square" stroke-width="2" d="M7 17L3 12m0 0l4-5m-4 5h18" />
            </svg>
            Back to home
          </a>
          <h1 class="text-4xl md:text-5xl font-bold mt-4">
            All <span class="text-accent">Writeups</span>
          </h1>
          <p class="mt-4 text-text-secondary max-w-xl">
            CTF solutions, vulnerability analyses, and security research. Filter by category below.
          </p>
        </div>

        <!-- Category filter -->
        <div class="flex flex-wrap gap-2 mb-12">
          {categories.map((cat) => (
            <button
              data-filter={cat}
              class={`filter-btn font-mono text-xs uppercase tracking-widest px-3 py-1.5 border transition-colors ${
                cat === 'all'
                  ? 'border-accent text-accent bg-accent/5'
                  : 'border-border text-text-muted hover:border-accent/40 hover:text-accent'
              }`}
            >
              {cat}
            </button>
          ))}
        </div>

        {writeups.length > 0 ? (
          <div class="space-y-px">
            {writeups.map((writeup) => (
              <a
                href={`/writeups/${writeup.id}`}
                data-category={writeup.data.category}
                class="writeup-item group flex flex-col md:flex-row md:items-center gap-4 p-6 bg-bg-surface hover:bg-bg-elevated border border-border transition-colors"
              >
                <div class="flex items-center gap-3 md:w-48 flex-shrink-0">
                  <span class={`font-mono text-[10px] uppercase tracking-widest px-2 py-0.5 border ${categoryColor(writeup.data.category)}`}>
                    {writeup.data.category}
                  </span>
                  <span class="font-mono text-[11px] text-text-muted">
                    {new Date(writeup.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </span>
                </div>
                <div class="flex-1">
                  <h2 class="text-lg font-semibold group-hover:text-accent transition-colors">
                    {writeup.data.title}
                  </h2>
                  <p class="text-sm text-text-secondary mt-1">
                    {writeup.data.description}
                  </p>
                </div>
                <svg class="w-4 h-4 text-text-muted group-hover:text-accent transition-colors flex-shrink-0 hidden md:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="square" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            ))}
          </div>
        ) : (
          <div class="border border-dashed border-border p-16 text-center bg-bg-surface">
            <div class="font-mono text-xl text-text-muted mb-3">No published writeups yet</div>
            <p class="text-sm text-text-muted max-w-md mx-auto">
              Writeups are in progress. Check back soon for CTF solutions, vulnerability analyses, and security research.
            </p>
          </div>
        )}
      </div>
    </section>
  </main>
</Layout>

<script>
  document.querySelectorAll('.filter-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter;

      // Update active state
      document.querySelectorAll('.filter-btn').forEach((b) => {
        b.classList.remove('border-accent', 'text-accent', 'bg-accent/5');
        b.classList.add('border-border', 'text-text-muted');
      });
      btn.classList.add('border-accent', 'text-accent', 'bg-accent/5');
      btn.classList.remove('border-border', 'text-text-muted');

      // Filter items
      document.querySelectorAll('.writeup-item').forEach((item) => {
        const el = item as HTMLElement;
        if (filter === 'all' || el.dataset.category === filter) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });
</script>
