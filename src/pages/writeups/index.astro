---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import {
  getPublishedWriteups,
  getSlug,
  readingTime,
  formatDate,
  typeColor,
  severityColor,
  difficultyColor,
  TYPE_TABS,
  TYPE_LABELS,
} from '../../lib/writeups';

const writeups = await getPublishedWriteups();

const counts: Record<string, number> = { all: writeups.length };
for (const w of writeups) {
  counts[w.data.type] = (counts[w.data.type] ?? 0) + 1;
}
const tabs = TYPE_TABS.filter((t) => t.id === 'all' || (counts[t.id] ?? 0) > 0);
---

<Layout title="Writeups | Jonas Resch" description="Security research, CVE disclosures, HackTheBox machine writeups, and general blog posts by Jonas Resch.">
  <Nav />
  <main class="pt-14">
    <section class="py-24">
      <div class="max-w-6xl mx-auto px-6">
        <!-- Header -->
        <div class="mb-12">
          <a href="/" class="font-mono text-sm text-text-muted hover:text-accent transition-colors mb-6 inline-flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="square" stroke-width="2" d="M7 17L3 12m0 0l4-5m-4 5h18" />
            </svg>
            Back to home
          </a>
          <h1 class="text-4xl md:text-5xl font-bold mt-4">
            Research &amp; <span class="text-accent">Writing</span>
          </h1>
          <p class="mt-4 text-text-secondary max-w-xl">
            CVE disclosures, HackTheBox machine writeups, and general blog posts. Filter by category below.
          </p>
        </div>

        <!-- Type tabs -->
        <div class="flex flex-wrap gap-2 mb-12 border-b border-border pb-px">
          {tabs.map((tab) => (
            <button
              data-filter={tab.id}
              class={`filter-btn font-mono text-xs uppercase tracking-widest px-4 py-2 border-b-2 -mb-px transition-colors ${
                tab.id === 'all'
                  ? 'border-accent text-accent'
                  : 'border-transparent text-text-muted hover:text-accent'
              }`}
            >
              {tab.label}
              <span class="ml-1.5 text-[10px] opacity-60">{counts[tab.id] ?? 0}</span>
            </button>
          ))}
        </div>

        {writeups.length > 0 ? (
          <div class="space-y-px">
            {writeups.map((writeup) => (
              <a
                href={`/writeups/${getSlug(writeup)}`}
                data-category={writeup.data.type}
                class="writeup-item group flex flex-col md:flex-row md:items-center gap-4 p-6 bg-bg-surface hover:bg-bg-elevated border border-border transition-colors"
              >
                <div class="flex items-center gap-2 md:w-56 flex-shrink-0 flex-wrap">
                  <span class={`font-mono text-[10px] uppercase tracking-widest px-2 py-0.5 border ${typeColor(writeup.data.type)}`}>
                    {TYPE_LABELS[writeup.data.type]}
                  </span>
                  {writeup.data.type === 'cve' && writeup.data.severity && (
                    <span class={`font-mono text-[10px] uppercase tracking-widest px-2 py-0.5 border ${severityColor(writeup.data.severity)}`}>
                      {writeup.data.severity}{writeup.data.cvss ? ` ${writeup.data.cvss}` : ''}
                    </span>
                  )}
                  {writeup.data.type === 'htb' && writeup.data.difficulty && (
                    <span class={`font-mono text-[10px] uppercase tracking-widest px-2 py-0.5 border ${difficultyColor(writeup.data.difficulty)}`}>
                      {writeup.data.difficulty}
                    </span>
                  )}
                </div>
                <div class="flex-1 min-w-0">
                  <h2 class="text-lg font-semibold group-hover:text-accent transition-colors">
                    {writeup.data.title}
                  </h2>
                  <p class="text-sm text-text-secondary mt-1">
                    {writeup.data.description}
                  </p>
                </div>
                <div class="flex items-center gap-3 md:flex-col md:items-end flex-shrink-0 md:w-28">
                  <span class="font-mono text-[11px] text-text-muted">
                    {formatDate(writeup.data.date)}
                  </span>
                  <span class="font-mono text-[11px] text-text-muted">
                    {readingTime(writeup.body)} min read
                  </span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="border border-dashed border-border p-16 text-center bg-bg-surface">
            <div class="font-mono text-xl text-text-muted mb-3">No published writeups yet</div>
            <p class="text-sm text-text-muted max-w-md mx-auto">
              Writeups are in progress. Check back soon for CVE disclosures, HackTheBox machines, and security research.
            </p>
          </div>
        )}
      </div>
    </section>
  </main>
</Layout>

<script>
  document.querySelectorAll('.filter-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter;

      document.querySelectorAll('.filter-btn').forEach((b) => {
        b.classList.remove('border-accent', 'text-accent');
        b.classList.add('border-transparent', 'text-text-muted');
      });
      btn.classList.add('border-accent', 'text-accent');
      btn.classList.remove('border-transparent', 'text-text-muted');

      document.querySelectorAll('.writeup-item').forEach((item) => {
        const el = item as HTMLElement;
        el.style.display = filter === 'all' || el.dataset.category === filter ? '' : 'none';
      });
    });
  });
</script>
