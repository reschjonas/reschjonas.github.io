---

<section id="contact" class="relative py-16 md:py-24 border-t border-border">
  <div class="max-w-6xl mx-auto px-6" data-reveal>
    <!-- Section header -->
    <div class="mb-10 md:mb-16">
      <div class="font-mono text-sm text-accent mb-3 flex items-center gap-2">
        <span class="w-8 h-px bg-accent inline-block"></span>
        06 // Contact
      </div>
      <h2 class="text-3xl md:text-4xl font-bold">
        Get in <span class="text-accent">Touch</span>
      </h2>
      <p class="mt-4 text-text-secondary max-w-xl">
        Interested in collaboration, responsible disclosure, or just want to talk security? Reach out.
      </p>
    </div>

    <!-- Contact links -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-px bg-border" data-reveal-group>
      {links.map((link) => (
        <a
          href={link.url}
          target={link.url.startsWith('mailto') ? undefined : '_blank'}
          rel={link.url.startsWith('mailto') ? undefined : 'noopener noreferrer'}
          data-reveal-item
          class="group bg-bg-surface p-6 hover:bg-bg-elevated transition-colors flex items-center gap-4"
        >
          <div class="text-text-muted group-hover:text-accent transition-all duration-300 group-hover:-translate-y-0.5 flex-shrink-0" set:html={link.icon} />
          <div>
            <div class="text-sm font-semibold group-hover:text-accent transition-colors">{link.name}</div>
            <div class="font-mono text-xs text-text-muted break-all">{link.desc}</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="border-t border-border py-8">
  <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="font-mono text-xs text-text-muted">
      &copy; {new Date().getFullYear()} Jonas Resch. All rights reserved.
    </div>
    <div class="font-mono text-xs text-text-muted flex items-center gap-2">
      <span class="w-1.5 h-1.5 bg-accent inline-block"></span>
      Built with Astro
    </div>
  </div>
</footer>
