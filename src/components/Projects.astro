---
const projects = [
  {
    name: 'FlipperZero BadUSB',
    desc: 'Next-generation modular payload system for Flipper Zero BadUSB, with advanced DuckyScript payloads and remote module loading.',
    tech: ['Python', 'PowerShell'],
    url: 'https://github.com/reschjonas/FlipperZero_BadUSB',
    stars: 10,
    category: 'Hardware Hacking',
  },
  {
    name: 'Leaktor',
    desc: 'Secrets scanner built for speed. Combines pattern matching, entropy analysis, and live validation to catch leaked credentials before they hit production.',
    tech: ['Rust', 'CLI'],
    url: 'https://github.com/reschjonas/leaktor',
    stars: 5,
    category: 'Secret Scanning',
  },
  {
    name: 'Inscribe',
    desc: 'Fast, elegant USB imaging for Linux. A modern, open-source alternative to balenaEtcher with a clean UI, clear progress, and power-user controls.',
    tech: ['TypeScript', 'Rust'],
    url: 'https://github.com/reschjonas/Inscribe',
    stars: 4,
    category: 'Systems',
  },
];
---

<section id="projects" class="relative py-16 md:py-24 border-t border-border">
  <div class="max-w-6xl mx-auto px-6" data-reveal>
    <!-- Section header -->
    <div class="mb-10 md:mb-16">
      <div class="font-mono text-sm text-accent mb-3 flex items-center gap-2">
        <span class="w-8 h-px bg-accent inline-block"></span>
        02 // Projects
      </div>
      <h2 class="text-3xl md:text-4xl font-bold">
        <span class="text-accent">Projects</span>
      </h2>
      <p class="mt-4 text-text-secondary max-w-xl">
        Open-source tools and utilities I've built and maintain.
      </p>
    </div>

    <!-- Projects grid -->
    <div class="grid md:grid-cols-3 gap-px bg-border" data-reveal-group>
      {projects.map((project) => (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          data-reveal-item
          class="group relative bg-bg-surface p-6 hover:bg-bg-elevated transition-colors block"
        >
          <span class="absolute top-0 left-0 h-px w-0 bg-accent transition-all duration-500 ease-out group-hover:w-full"></span>
          <!-- Header -->
          <div class="flex items-start justify-between mb-4">
            <div>
              <span class="font-mono text-[10px] uppercase tracking-widest text-text-muted block mb-1.5">
                {project.category}
              </span>
              <h3 class="text-lg font-semibold group-hover:text-accent transition-colors">
                {project.name}
              </h3>
            </div>
            <svg class="w-4 h-4 text-text-muted group-hover:text-accent transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="square" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
            </svg>
          </div>

          <!-- Description -->
          <p class="text-sm text-text-secondary leading-relaxed mb-5">
            {project.desc}
          </p>

          <!-- Footer -->
          <div class="flex items-center justify-between mt-auto">
            <div class="flex flex-wrap gap-2">
              {project.tech.map((t) => (
                <span class="font-mono text-[11px] text-accent/80 bg-accent/5 border border-accent/15 px-2 py-0.5">
                  {t}
                </span>
              ))}
            </div>
            {project.stars && (
              <span class="font-mono text-xs text-text-muted flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                </svg>
                {project.stars}
              </span>
            )}
          </div>
        </a>
      ))}
    </div>

    <!-- GitHub link -->
    <div class="mt-8 text-center">
      <a
        href="https://github.com/reschjonas"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 font-mono text-sm text-text-secondary hover:text-accent transition-colors"
      >
        <span>View all repositories on GitHub</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="square" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
