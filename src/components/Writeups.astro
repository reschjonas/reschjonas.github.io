---
import {
  getPublishedWriteups,
  getSlug,
  formatDate,
  readingTime,
  typeColor,
  TYPE_LABELS,
} from '../lib/writeups';

const writeups = (await getPublishedWriteups()).slice(0, 4);
---

<section id="writeups" class="relative py-16 md:py-24 border-t border-border">
  <div class="relative max-w-6xl mx-auto px-6" data-reveal>
    <span class="pointer-events-none absolute right-6 -top-6 md:-top-10 font-mono font-extrabold text-[5rem] md:text-[8rem] leading-none text-text-primary/[0.035] select-none">04</span>
    <!-- Section header -->
    <div class="mb-10 md:mb-16 flex items-end justify-between">
      <div>
        <div class="font-mono text-sm text-accent mb-3 flex items-center gap-2">
          <span class="w-8 h-px bg-accent inline-block"></span>
          04 // Research &amp; Writing
        </div>
        <h2 class="text-3xl md:text-4xl font-bold">
          Latest <span class="text-gradient">Writeups</span>
        </h2>
        <p class="mt-4 text-text-secondary max-w-xl">
          CVE disclosures, HackTheBox machines, and technical deep-dives into security topics.
        </p>
      </div>
      <a
        href="/writeups"
        class="hidden sm:inline-flex items-center gap-2 font-mono text-sm text-text-secondary hover:text-accent transition-colors"
      >
        View all
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="square" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

    {writeups.length > 0 ? (
      <div class={`grid gap-4 ${writeups.length > 1 ? 'md:grid-cols-2' : 'grid-cols-1'}`} data-reveal-group>
        {writeups.map((writeup) => (
          <a
            href={`/writeups/${getSlug(writeup)}`}
            data-reveal-item
            class="group relative overflow-hidden rounded-2xl border border-border bg-bg-surface p-6 hover:border-accent/40 hover:-translate-y-1 hover:bg-bg-elevated transition-all duration-300 block"
          >
            <span class="absolute top-0 left-0 h-px w-0 bg-accent transition-all duration-500 ease-out group-hover:w-full"></span>
            <div class="flex items-center gap-3 mb-3">
              <span class={`font-mono text-[10px] uppercase tracking-widest px-2 py-0.5 border ${typeColor(writeup.data.type)}`}>
                {TYPE_LABELS[writeup.data.type]}
              </span>
              <span class="font-mono text-[11px] text-text-muted">
                {formatDate(writeup.data.date)}
              </span>
              <span class="font-mono text-[11px] text-text-muted">·</span>
              <span class="font-mono text-[11px] text-text-muted">{readingTime(writeup.body)} min</span>
            </div>
            <h3 class="text-lg font-semibold mb-2 group-hover:text-accent transition-colors">
              {writeup.data.title}
            </h3>
            <p class="text-sm text-text-secondary leading-relaxed mb-4">
              {writeup.data.description}
            </p>
            <div class="flex flex-wrap gap-2">
              {writeup.data.tags.map((tag: string) => (
                <span class="font-mono text-[10px] text-text-muted">
                  #{tag}
                </span>
              ))}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="border border-dashed border-border p-12 text-center bg-bg-surface">
        <div class="font-mono text-lg text-text-muted mb-2">No writeups yet</div>
        <p class="text-sm text-text-muted">
          Writeups will appear here once published. Check back soon.
        </p>
      </div>
    )}

    <div class="mt-8 text-center sm:hidden">
      <a
        href="/writeups"
        class="inline-flex items-center gap-2 font-mono text-sm text-text-secondary hover:text-accent transition-colors"
      >
        View all writeups
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="square" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
