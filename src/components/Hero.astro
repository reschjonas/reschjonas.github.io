---
---

<section class="relative min-h-screen flex items-center pt-20">
  <!-- Background grid pattern -->
  <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(var(--color-accent) 1px, transparent 1px), linear-gradient(90deg, var(--color-accent) 1px, transparent 1px); background-size: 60px 60px;"></div>

  <!-- Ember glow -->
  <div class="absolute inset-0 ember-glow"></div>

  <!-- Gradient overlay from top -->
  <div class="absolute top-0 left-0 right-0 h-40 bg-gradient-to-b from-bg to-transparent"></div>

  <div class="relative max-w-6xl mx-auto px-6 py-16 md:py-24 w-full">
    <div class="grid lg:grid-cols-3 gap-12 items-center">
      <!-- Left: Main content -->
      <div class="lg:col-span-2">
        <!-- Terminal-style prefix -->
        <div class="animate-fade-in-up font-mono text-sm text-text-muted mb-6 flex items-center gap-2">
          <span class="text-accent">$</span>
          <span>whoami</span>
        </div>

        <!-- Name -->
        <h1 class="animate-fade-in-up delay-100 text-4xl sm:text-5xl md:text-7xl font-bold tracking-tight mb-4">
          Jonas <span class="text-gradient">Resch</span>
        </h1>

        <!-- Subtitle -->
        <p class="animate-fade-in-up delay-200 font-mono text-base sm:text-lg md:text-xl text-text-secondary mb-8">
          Offensive Security<span class="text-text-muted"> // </span>Vulnerability Research<span class="text-text-muted"> // </span>CS Student
        </p>

        <!-- Bio -->
        <p class="animate-fade-in-up delay-300 text-text-secondary max-w-xl leading-relaxed mb-10">
          Computer science student specializing in IT security at Mittweida University of Applied Sciences,
          where I also work as a student at the university's data center. I spend my time rooting machines
          on HackTheBox, researching vulnerabilities, and lately digging into offensive AI.
        </p>

        <!-- Status tags -->
        <div class="animate-fade-in-up delay-400 flex flex-wrap gap-3 mb-10">
          <span class="inline-flex items-center gap-2 px-3 py-1.5 border border-border bg-bg-surface text-sm font-mono text-text-secondary">
            <span class="w-2 h-2 bg-accent inline-block"></span>
            HackTheBox Top 500
          </span>
          <span class="inline-flex items-center gap-2 px-3 py-1.5 border border-border bg-bg-surface text-sm font-mono text-text-secondary">
            <span class="w-2 h-2 bg-info inline-block"></span>
            B.Sc. CS (IT Security) @ Mittweida
          </span>
          <span class="inline-flex items-center gap-2 px-3 py-1.5 border border-border bg-bg-surface text-sm font-mono text-text-secondary">
            <span class="w-2 h-2 bg-warning inline-block"></span>
            Working Student @ HSMW NCC
          </span>
        </div>

        <!-- CTA links -->
        <div class="animate-fade-in-up delay-500 flex flex-wrap gap-4">
          <a href="/writeups" class="group btn-accent inline-flex items-center gap-2 px-5 py-2.5 font-mono text-sm font-semibold hover:-translate-y-0.5">
            Read Writeups
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="square" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="#cves" class="inline-flex items-center gap-2 px-5 py-2.5 border border-border text-text-secondary hover:border-accent hover:text-accent font-mono text-sm transition-all">
            View Research
          </a>
        </div>
      </div>

      <!-- Right: Terminal window -->
      <div class="animate-fade-in-up delay-400">
        <div class="rounded-xl border border-border bg-bg-surface/80 backdrop-blur-sm shadow-2xl shadow-black/40 overflow-hidden">
          <!-- Title bar -->
          <div class="flex items-center gap-2 px-4 py-2.5 border-b border-border bg-bg-elevated/60">
            <span class="w-3 h-3 rounded-full bg-danger/80"></span>
            <span class="w-3 h-3 rounded-full bg-warning/80"></span>
            <span class="w-3 h-3 rounded-full bg-accent/80"></span>
            <span class="ml-2 font-mono text-[11px] text-text-muted">jonas@resch: ~</span>
          </div>
          <!-- Body -->
          <div class="p-5 font-mono text-[13px] leading-relaxed">
            <div class="text-text-secondary"><span class="text-accent">$</span> cat profile.json</div>
            <div class="mt-2 space-y-1.5">
              <div class="flex justify-between gap-4"><span class="text-text-muted">cves_published</span><span class="text-text-primary">1</span></div>
              <div class="flex justify-between gap-4"><span class="text-text-muted">htb_rank</span><span class="text-text-primary">Top 500</span></div>
              <div class="flex justify-between gap-4"><span class="text-text-muted">pro_lab</span><span class="text-text-primary">Solar</span></div>
              <div class="flex justify-between gap-4"><span class="text-text-muted">team</span><span class="text-text-primary">RaptX</span></div>
              <div class="flex justify-between gap-4"><span class="text-text-muted">focus</span><span class="text-accent">Offensive AI</span></div>
              <div class="flex justify-between gap-4"><span class="text-text-muted">location</span><span class="text-text-primary">Germany</span></div>
            </div>
            <div class="mt-4 text-text-secondary">
              <span class="text-accent">$</span> <span class="inline-block w-2 h-4 align-middle bg-accent animate-blink"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom gradient -->
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-accent/30 to-transparent"></div>
</section>
